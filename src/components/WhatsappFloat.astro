---
import '@fontsource/quicksand/latin-600.css';
import type { Lang } from '../i18n/config';
import { whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const wa = whatsappLink(lang);

const copy: Record<Lang, { text: string; close: string }> = {
  es: { text: '¿Hablamos por WhatsApp?', close: 'Cerrar mensaje' },
  va: { text: 'Parlem per WhatsApp?', close: 'Tancar missatge' },
  en: { text: "Let's chat on WhatsApp", close: 'Close message' },
};
const t = copy[lang];
---

<!-- Popup tipo tooltip (aparece a los 3 s, se auto-oculta a los 7 s) -->
<div class="whatsapp-tooltip" id="wa-tooltip" hidden>
  <button class="whatsapp-tooltip-close" type="button" aria-label={t.close}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>
  <a class="whatsapp-tooltip-link" href={wa} target="_blank" rel="noopener noreferrer">
    <span class="whatsapp-tooltip-emoji" aria-hidden="true">👋</span>
    <span class="whatsapp-tooltip-text">{t.text}</span>
  </a>
</div>

<a class="whatsapp-float" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
  <svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
    <path d="M12.04 2a9.9 9.9 0 0 0-8.46 15.05L2 22l5.07-1.33A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.2 8.2 0 1 1 6.95 3.85Zm4.5-6.14c-.25-.12-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.12-.17.25-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.38-1.72c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42l-.48-.01c-.16 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.21.88 2.39 1 2.55.13.17 1.74 2.66 4.21 3.73.59.25 1.05.4 1.4.52.59.18 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z" />
  </svg>
</a>

<script>
  const tip = document.getElementById('wa-tooltip');
  if (tip) {
    const closeBtn = tip.querySelector('.whatsapp-tooltip-close');
    let auto: number | undefined;
    const hide = () => {
      window.clearTimeout(auto);
      tip.classList.remove('is-visible');
      window.setTimeout(() => tip.setAttribute('hidden', ''), 400);
    };
    closeBtn?.addEventListener('click', hide);
    window.setTimeout(() => {
      tip.removeAttribute('hidden');
      void tip.offsetWidth;
      tip.classList.add('is-visible');
      auto = window.setTimeout(hide, 7000);
    }, 3000);
  }

  // Aparta el botón flotante cuando el footer entra en pantalla, para que
  // no tape el crédito final ni los enlaces legales.
  const floatBtn = document.querySelector<HTMLElement>('.whatsapp-float');
  const footer = document.querySelector('footer.footer');
  if (floatBtn && footer) {
    const io = new IntersectionObserver(
      ([entry]) => floatBtn.classList.toggle('is-clear', entry.isIntersecting),
      { rootMargin: '0px 0px -12px 0px' }
    );
    io.observe(footer);
  }
</script>

<style>
  /* ── Botón flotante (idéntico a clinicalauraserra.com) ── */
  .whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 56px;
    height: 56px;
    background: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 95;
    box-shadow: 0 10px 26px -8px var(--accent-glow);
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease,
      opacity 0.25s ease;
  }
  /* Cuando el footer está a la vista, se aparta para no tapar el
     crédito final ni los enlaces legales. */
  .whatsapp-float.is-clear {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }
  .whatsapp-float :global(svg) {
    width: 30px;
    height: 30px;
  }
  .whatsapp-float:hover {
    background: var(--accent-2);
    box-shadow: 0 14px 34px -8px var(--accent-glow);
    transform: translateY(-2px);
  }

  /* ── Popup flotante ── */
  .whatsapp-tooltip {
    position: fixed;
    bottom: 92px;
    right: 16px;
    z-index: 95;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100vw - 32px);
    padding: 9px 12px 9px 10px;
    border-radius: 14px;
    background: linear-gradient(135deg, #fb5412 0%, #e8470a 100%);
    box-shadow: rgba(232, 71, 10, 0.45) 0px 8px 24px, rgba(232, 71, 10, 0.2) 0px 1px 3px;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.4s ease-out, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .whatsapp-tooltip.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .whatsapp-tooltip::after {
    content: '';
    position: absolute;
    bottom: -5px;
    right: 36px;
    width: 12px;
    height: 12px;
    background: #e8470a;
    transform: rotate(45deg);
    box-shadow: rgba(232, 71, 10, 0.18) 4px 4px 7px;
    border-bottom-right-radius: 3px;
  }
  .whatsapp-tooltip-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    text-decoration: none;
    font-family: 'Quicksand', sans-serif;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    padding: 2px 2px 2px 0;
  }
  .whatsapp-tooltip-link:hover {
    color: #ffc7a8;
  }
  .whatsapp-tooltip-emoji {
    font-size: 1.05rem;
    line-height: 1;
  }
  .whatsapp-tooltip-close {
    appearance: none;
    background: transparent;
    border: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.7);
    flex-shrink: 0;
    padding: 0;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .whatsapp-tooltip-close:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .whatsapp-tooltip-close svg {
    width: 11px;
    height: 11px;
  }
</style>
