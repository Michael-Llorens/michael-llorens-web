---
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getProjects } from '../data/content';

/* Tira de "negocios que confían en nosotros".
   Usa los proyectos REALES ya entregados. Si añades un logo en
   /public/clients/<slug>.svg (o .png/.webp) y rellenas la ruta en `logo`,
   se mostrará la imagen; si no, se muestra el nombre con estilo. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Logos opcionales por slug. Pon aquí la ruta cuando tengas el logo del cliente.
const logos: Record<string, string | undefined> = {
  beply: undefined,
  'taxi-xativa': undefined,
  'clinica-laura-serra': undefined,
  onllum: undefined,
  'el-buey-madurado': undefined,
};

const clients = getProjects(lang).map((p) => ({ name: p.name, logo: logos[p.slug] }));
---

<section class="clients" aria-label={t('clients.title')}>
  <div class="container clients__inner" data-reveal>
    <span class="clients__label">{t('clients.title')}</span>
    <ul class="clients__row">
      {
        clients.map((c) => (
          <li class="clients__item">
            {c.logo ? (
              <img src={c.logo} alt={c.name} height="20" loading="lazy" />
            ) : (
              <span class="clients__name">{c.name}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Franja de confianza compacta: valida rápido sin competir con el
     portfolio (que es la prueba social real, con capturas). */
  .clients {
    padding-block: clamp(1.3rem, 2.6vw, 1.8rem);
    border-block: 1px solid var(--border);
  }
  .clients__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem 1.6rem;
  }
  .clients__label {
    flex-shrink: 0;
    color: var(--text-dim);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .clients__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
  .clients__item {
    display: flex;
    align-items: center;
    opacity: 0.7;
    transition: opacity 0.25s ease;
  }
  .clients__item:not(:last-child)::after {
    content: '';
    width: 1px;
    height: 13px;
    margin-inline: 1rem;
    background: var(--border-strong);
  }
  .clients__item:hover {
    opacity: 1;
  }
  .clients__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.005em;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 0.25s ease;
  }
  .clients__item:hover .clients__name {
    color: var(--text);
  }
  .clients__item img {
    width: auto;
    height: 20px;
    filter: grayscale(1);
    opacity: 0.85;
    transition: filter 0.25s ease, opacity 0.25s ease;
  }
  .clients__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .clients__inner {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
