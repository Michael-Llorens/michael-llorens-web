---
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy: Record<
  Lang,
  {
    kicker: string;
    title: string;
    subtitle: string;
    playerA: string;
    playerB: string;
    reset: string;
    note: string;
    modeFutbol: string;
    modePadel: string;
    sets: string;
    games: string;
    points: string;
    point: string;
    goal: string;
    deuce: string;
    advantage: string;
    matchWon: string;
  }
> = {
  es: {
    kicker: 'Pruébalo',
    title: 'Así se vería tu marcador',
    subtitle: 'Un ejemplo sencillo de cómo jugadores y espectadores verían el resultado en directo, desde el móvil.',
    playerA: 'Jugador / equipo 1',
    playerB: 'Jugador / equipo 2',
    reset: 'Reiniciar',
    note: 'Esto es solo un ejemplo. En tu web real el marcador se actualiza para todos los espectadores a la vez, con clasificación y cuadro de partidos incluidos.',
    modeFutbol: 'Fútbito',
    modePadel: 'Pádel',
    sets: 'Sets',
    games: 'Juegos',
    points: 'Puntos',
    point: 'Punto',
    goal: 'Gol',
    deuce: 'Iguales',
    advantage: 'Ventaja',
    matchWon: '¡Partido ganado!',
  },
  va: {
    kicker: 'Prova-ho',
    title: 'Així es veuria el teu marcador',
    subtitle: 'Un exemple senzill de com jugadors i espectadors veurien el resultat en directe, des del mòbil.',
    playerA: 'Jugador / equip 1',
    playerB: 'Jugador / equip 2',
    reset: 'Reiniciar',
    note: 'Açò és només un exemple. En la teua web real el marcador s’actualitza per a tots els espectadors alhora, amb classificació i quadre de partits inclosos.',
    modeFutbol: 'Futbito',
    modePadel: 'Pàdel',
    sets: 'Sets',
    games: 'Jocs',
    points: 'Punts',
    point: 'Punt',
    goal: 'Gol',
    deuce: 'Iguals',
    advantage: 'Avantatge',
    matchWon: 'Partit guanyat!',
  },
  en: {
    kicker: 'Try it',
    title: 'This is what your scoreboard could look like',
    subtitle: 'A simple example of how players and spectators would see the live score, from any phone.',
    playerA: 'Player / team 1',
    playerB: 'Player / team 2',
    reset: 'Reset',
    note: 'This is just an example. On your real website the scoreboard updates for every spectator at once, with standings and a match bracket included.',
    modeFutbol: 'Five-a-side',
    modePadel: 'Padel',
    sets: 'Sets',
    games: 'Games',
    points: 'Points',
    point: 'Point',
    goal: 'Goal',
    deuce: 'Deuce',
    advantage: 'Advantage',
    matchWon: 'Match won!',
  },
};
const t = copy[lang];
---

<section class="section section--tight section--alt scoreboard">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="kicker">{t.kicker}</span>
      <h2 class="section-title">{t.title}</h2>
      <p class="lead">{t.subtitle}</p>
    </div>

    <div class="mode-toggle" data-reveal role="group" aria-label="Deporte">
      <button type="button" class="mode-toggle__btn is-active" data-mode="futbol">{t.modeFutbol}</button>
      <button type="button" class="mode-toggle__btn" data-mode="padel">{t.modePadel}</button>
    </div>

    <!-- Fútbito: marcador simple de goles -->
    <div class="score-demo card" data-panel="futbol">
      <div class="score-demo__side">
        <span class="score-demo__label">{t.playerA}</span>
        <span class="score-demo__value" id="goals-a">0</span>
        <button type="button" class="btn btn-ghost score-demo__btn" data-sport="futbol" data-target="a">
          +1 {t.goal}
        </button>
      </div>
      <span class="score-demo__divider" aria-hidden="true">—</span>
      <div class="score-demo__side">
        <span class="score-demo__label">{t.playerB}</span>
        <span class="score-demo__value" id="goals-b">0</span>
        <button type="button" class="btn btn-ghost score-demo__btn" data-sport="futbol" data-target="b">
          +1 {t.goal}
        </button>
      </div>
    </div>

    <!-- Pádel: puntos, juegos y sets de verdad -->
    <div class="score-demo score-demo--padel card" data-panel="padel" hidden>
      <div class="score-demo__side">
        <span class="score-demo__label">{t.playerA}</span>
        <dl class="score-demo__stats">
          <div><dt>{t.sets}</dt><dd id="padel-sets-a">0</dd></div>
          <div><dt>{t.games}</dt><dd id="padel-games-a">0</dd></div>
          <div class="score-demo__stat--big"><dt>{t.points}</dt><dd id="padel-points-a">0</dd></div>
        </dl>
        <button type="button" class="btn btn-ghost score-demo__btn" data-sport="padel" data-target="a">
          +1 {t.point}
        </button>
      </div>
      <span class="score-demo__divider" aria-hidden="true">—</span>
      <div class="score-demo__side">
        <span class="score-demo__label">{t.playerB}</span>
        <dl class="score-demo__stats">
          <div><dt>{t.sets}</dt><dd id="padel-sets-b">0</dd></div>
          <div><dt>{t.games}</dt><dd id="padel-games-b">0</dd></div>
          <div class="score-demo__stat--big"><dt>{t.points}</dt><dd id="padel-points-b">0</dd></div>
        </dl>
        <button type="button" class="btn btn-ghost score-demo__btn" data-sport="padel" data-target="b">
          +1 {t.point}
        </button>
      </div>
      <p class="score-demo__status" id="padel-status" aria-live="polite"></p>
    </div>

    <button type="button" class="score-demo__reset" id="score-reset">{t.reset}</button>
    <p class="score-demo__note" data-reveal>{t.note}</p>
  </div>
</section>

<script define:vars={{ deuceLabel: t.deuce, advantageLabel: t.advantage, matchWonLabel: t.matchWon }}>
  // ── Fútbito: contador simple de goles ──
  const goals = { a: 0, b: 0 };
  const goalsA = document.getElementById('goals-a');
  const goalsB = document.getElementById('goals-b');

  // ── Pádel: puntos → juegos → sets, con iguales/ventaja reales ──
  const padel = {
    points: { a: 0, b: 0 },
    games: { a: 0, b: 0 },
    sets: { a: 0, b: 0 },
    over: false,
  };
  const padelEl = {
    pointsA: document.getElementById('padel-points-a'),
    pointsB: document.getElementById('padel-points-b'),
    gamesA: document.getElementById('padel-games-a'),
    gamesB: document.getElementById('padel-games-b'),
    setsA: document.getElementById('padel-sets-a'),
    setsB: document.getElementById('padel-sets-b'),
    status: document.getElementById('padel-status'),
  };

  function pointLabel(p, o) {
    const labels = ['0', '15', '30', '40'];
    if (p >= 3 && o >= 3) {
      if (p === o) return '40';
      return p > o ? 'AD' : '40';
    }
    return labels[Math.min(p, 3)];
  }

  function renderPadel() {
    const { points, games, sets } = padel;
    if (padelEl.pointsA) padelEl.pointsA.textContent = pointLabel(points.a, points.b);
    if (padelEl.pointsB) padelEl.pointsB.textContent = pointLabel(points.b, points.a);
    if (padelEl.gamesA) padelEl.gamesA.textContent = String(games.a);
    if (padelEl.gamesB) padelEl.gamesB.textContent = String(games.b);
    if (padelEl.setsA) padelEl.setsA.textContent = String(sets.a);
    if (padelEl.setsB) padelEl.setsB.textContent = String(sets.b);

    if (!padelEl.status) return;
    if (padel.over) {
      padelEl.status.textContent = matchWonLabel;
    } else if (points.a >= 3 && points.b >= 3 && points.a === points.b) {
      padelEl.status.textContent = deuceLabel;
    } else if (points.a >= 3 && points.b >= 3) {
      padelEl.status.textContent = advantageLabel;
    } else {
      padelEl.status.textContent = '';
    }
  }

  function padelAddPoint(player) {
    if (padel.over) return;
    const opp = player === 'a' ? 'b' : 'a';
    padel.points[player]++;

    if (padel.points[player] >= 4 && padel.points[player] - padel.points[opp] >= 2) {
      padel.points.a = 0;
      padel.points.b = 0;
      padel.games[player]++;

      const g = padel.games[player];
      const go = padel.games[opp];
      if ((g >= 6 && g - go >= 2) || g === 7) {
        padel.games.a = 0;
        padel.games.b = 0;
        padel.sets[player]++;
        if (padel.sets[player] >= 2) padel.over = true;
      }
    }
    renderPadel();
  }

  document.querySelectorAll('.score-demo__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target;
      if (btn.dataset.sport === 'futbol') {
        goals[target]++;
        const el = target === 'a' ? goalsA : goalsB;
        if (el) el.textContent = String(goals[target]);
      } else {
        padelAddPoint(target);
      }
    });
  });

  document.getElementById('score-reset')?.addEventListener('click', () => {
    goals.a = 0;
    goals.b = 0;
    if (goalsA) goalsA.textContent = '0';
    if (goalsB) goalsB.textContent = '0';

    padel.points = { a: 0, b: 0 };
    padel.games = { a: 0, b: 0 };
    padel.sets = { a: 0, b: 0 };
    padel.over = false;
    renderPadel();
  });

  // ── Selector de deporte ──
  const panels = document.querySelectorAll('[data-panel]');
  document.querySelectorAll('.mode-toggle__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode;
      document.querySelectorAll('.mode-toggle__btn').forEach((b) => b.classList.toggle('is-active', b === btn));
      panels.forEach((p) => {
        p.hidden = p.getAttribute('data-panel') !== mode;
      });
    });
  });

  renderPadel();
</script>

<style>
  .mode-toggle {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.2rem);
  }
  .mode-toggle__btn {
    padding: 0.55rem 1.3rem;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .mode-toggle__btn.is-active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--text);
  }

  .score-demo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.2rem, 4vw, 2.5rem);
    max-width: 620px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }
  .score-demo--padel {
    max-width: 680px;
  }
  .score-demo__side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .score-demo__label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .score-demo__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .score-demo__btn {
    padding: 0.5rem 1.4rem;
    white-space: nowrap;
  }
  .score-demo__divider {
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Pádel: sets / juegos / puntos */
  .score-demo__stats {
    display: flex;
    align-items: baseline;
    gap: clamp(0.8rem, 3vw, 1.5rem);
  }
  .score-demo__stats > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .score-demo__stats dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }
  .score-demo__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .score-demo__stat--big dd {
    font-size: clamp(2.2rem, 6vw, 2.8rem);
    color: var(--text);
  }
  .score-demo__status {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    min-height: 1.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-2);
  }

  .score-demo__reset {
    display: block;
    margin: 1.4rem auto 0;
    color: var(--text-dim);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .score-demo__reset:hover {
    color: var(--accent-2);
  }

  .score-demo__note {
    max-width: 56ch;
    margin: 1.6rem auto 0;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .score-demo {
      grid-template-columns: 1fr;
    }
    .score-demo__divider {
      display: none;
    }
    .score-demo__stats {
      gap: 1.4rem;
    }
  }
</style>
