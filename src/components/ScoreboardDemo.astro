---
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy: Record<
  Lang,
  {
    kicker: string;
    title: string;
    subtitle: string;
    playerA: string;
    playerB: string;
    reset: string;
    note: string;
  }
> = {
  es: {
    kicker: 'Pruébalo',
    title: 'Así se vería tu marcador',
    subtitle: 'Un ejemplo sencillo de cómo jugadores y espectadores verían el resultado en directo, desde el móvil.',
    playerA: 'Jugador / equipo 1',
    playerB: 'Jugador / equipo 2',
    reset: 'Reiniciar',
    note: 'Esto es solo un ejemplo. En tu web real el marcador se actualiza para todos los espectadores a la vez, con clasificación y cuadro de partidos incluidos.',
  },
  va: {
    kicker: 'Prova-ho',
    title: 'Així es veuria el teu marcador',
    subtitle: 'Un exemple senzill de com jugadors i espectadors veurien el resultat en directe, des del mòbil.',
    playerA: 'Jugador / equip 1',
    playerB: 'Jugador / equip 2',
    reset: 'Reiniciar',
    note: 'Açò és només un exemple. En la teua web real el marcador s’actualitza per a tots els espectadors alhora, amb classificació i quadre de partits inclosos.',
  },
  en: {
    kicker: 'Try it',
    title: 'This is what your scoreboard could look like',
    subtitle: 'A simple example of how players and spectators would see the live score, from any phone.',
    playerA: 'Player / team 1',
    playerB: 'Player / team 2',
    reset: 'Reset',
    note: 'This is just an example. On your real website the scoreboard updates for every spectator at once, with standings and a match bracket included.',
  },
};
const t = copy[lang];
---

<section class="section section--tight section--alt scoreboard">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="kicker">{t.kicker}</span>
      <h2 class="section-title">{t.title}</h2>
      <p class="lead">{t.subtitle}</p>
    </div>

    <div class="score-demo card" data-reveal>
      <div class="score-demo__side">
        <span class="score-demo__label">{t.playerA}</span>
        <span class="score-demo__value" id="score-a">0</span>
        <button type="button" class="btn btn-ghost score-demo__btn" data-target="a">+1</button>
      </div>
      <span class="score-demo__divider" aria-hidden="true">—</span>
      <div class="score-demo__side">
        <span class="score-demo__label">{t.playerB}</span>
        <span class="score-demo__value" id="score-b">0</span>
        <button type="button" class="btn btn-ghost score-demo__btn" data-target="b">+1</button>
      </div>
    </div>

    <button type="button" class="score-demo__reset" id="score-reset">{t.reset}</button>
    <p class="score-demo__note" data-reveal>{t.note}</p>
  </div>
</section>

<script>
  const scores: Record<'a' | 'b', number> = { a: 0, b: 0 };
  const elA = document.getElementById('score-a');
  const elB = document.getElementById('score-b');

  document.querySelectorAll<HTMLButtonElement>('.score-demo__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target as 'a' | 'b';
      scores[target]++;
      const el = target === 'a' ? elA : elB;
      if (el) el.textContent = String(scores[target]);
    });
  });

  document.getElementById('score-reset')?.addEventListener('click', () => {
    scores.a = 0;
    scores.b = 0;
    if (elA) elA.textContent = '0';
    if (elB) elB.textContent = '0';
  });
</script>

<style>
  .score-demo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.2rem, 4vw, 2.5rem);
    max-width: 620px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }
  .score-demo__side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .score-demo__label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .score-demo__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 4.5rem);
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .score-demo__btn {
    padding: 0.5rem 1.4rem;
  }
  .score-demo__divider {
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .score-demo__reset {
    display: block;
    margin: 1.4rem auto 0;
    color: var(--text-dim);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .score-demo__reset:hover {
    color: var(--accent-2);
  }

  .score-demo__note {
    max-width: 56ch;
    margin: 1.6rem auto 0;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .score-demo {
      grid-template-columns: 1fr;
    }
    .score-demo__divider {
      display: none;
    }
  }
</style>
