---
import PageLayout from '../components/PageLayout.astro';
import Services from '../components/Services.astro';
import Extras from '../components/Extras.astro';
import BackendApis from '../components/BackendApis.astro';
import Process from '../components/Process.astro';
import SectorsList from '../components/SectorsList.astro';
import FinalCta from '../components/FinalCta.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'es';
const t = useTranslations(lang);
---

<PageLayout
  lang={lang}
  path="servicios"
  title={t('seo.services.title')}
  description={t('seo.services.description')}
>
  <Services lang={lang} asPageTitle />
  <Extras lang={lang} linkToContact />
  <BackendApis lang={lang} />
  <Process lang={lang} />
  <SectorsList lang={lang} />
  <FinalCta lang={lang} />
</PageLayout>
