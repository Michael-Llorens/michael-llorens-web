---
import PageLayout from '../../../components/PageLayout.astro';
import BlogArticle from '../../../components/BlogArticle.astro';
import { getBlogSlugs, getBlogPost } from '../../../data/blog';

export function getStaticPaths() {
  return getBlogSlugs().map((slug) => ({ params: { slug } }));
}

const lang = 'en';
const { slug } = Astro.params;
const post = getBlogPost(lang, slug as string)!;
---

<PageLayout
  lang={lang}
  path={`recursos/${post.slug}`}
  title={post.title.length <= 48 ? `${post.title} · MetaLogic` : post.title}
  description={post.excerpt}
  ogType="article"
>
  <BlogArticle lang={lang} post={post} />
</PageLayout>
